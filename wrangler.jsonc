{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yesva",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "2069c5aa-465f-4a76-a5fe-7dc75c6be8c5","database_name": "yesva" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "46526fa99e0f4b348c59ec8fc888c477" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
